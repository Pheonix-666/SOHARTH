# Supabase Configuration
# Replace these with your actual Supabase project credentials from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Admin Authentication
ADMIN_USER=admin
ADMIN_PASS=your-admin-password
ADMIN_SESSION_SECRET=your-random-secret-string

# UPI Payment Gateway (Google Pay, PhonePe, Paytm, BHIM)
NEXT_PUBLIC_UPI_ID=payments@soharth
NEXT_PUBLIC_UPI_NAME="SOHARTH ATELIER"
